# Obsidian MCP Server — example environment configuration.
# Copy to .env and fill in your values.

# ============================================================================
# Required: Obsidian Local REST API
# ============================================================================
OBSIDIAN_API_KEY=your-obsidian-local-rest-api-key
OBSIDIAN_BASE_URL=http://127.0.0.1:27123
OBSIDIAN_VERIFY_SSL=false

# ============================================================================
# Transport
# ============================================================================
MCP_TRANSPORT_TYPE=http
MCP_HTTP_PORT=3010
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_STATELESS=false

# ============================================================================
# Authentication mode
#   legacy = ?api_key= query string (default; existing behavior)
#   oauth  = OAuth 2.1 + PKCE with built-in shim authorization server
# ============================================================================
MCP_AUTH_MODE=legacy

# --- legacy mode ---
# In single-vault mode the OBSIDIAN_API_KEY above doubles as the MCP auth key.
# Override here if you want a separate key for MCP requests:
# MCP_AUTH_KEY=

# --- oauth mode (only required when MCP_AUTH_MODE=oauth) ---
# Public canonical origin of this server (no trailing slash). Claude.ai
# constructs /authorize, /token, /register on THIS host.
# MCP_OAUTH_ISSUER_URL=https://your-mcp-server.example.com

# HS256 signing secret. Must be ≥32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MCP_AUTH_SECRET_KEY=

# Token lifetimes (seconds). Defaults: access=1h, refresh=30d, code=10min.
# MCP_OAUTH_ACCESS_TOKEN_TTL_SEC=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL_SEC=2592000
# MCP_OAUTH_CODE_TTL_SEC=600

# Skip the consent page and auto-approve every /authorize request.
# Useful for single-user local PCs but disables the only UI check on phishing.
# MCP_OAUTH_AUTO_APPROVE=false

# ============================================================================
# Logging & misc
# ============================================================================
MCP_LOG_LEVEL=info
NODE_ENV=production
